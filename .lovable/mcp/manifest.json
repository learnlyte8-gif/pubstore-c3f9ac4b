{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ccprnnqxpnrkdrfsudjc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "pubstore-mcp",
      "version": "0.1.0",
      "title": "PUBSTORE"
    },
    "tools": [
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search PUBSTORE marketplace products by keyword. Returns id, title, price, category, and supplier for each match.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keyword or phrase to match against product titles/descriptions."
            },
            "category": {
              "type": "string",
              "description": "Optional category slug filter (e.g. 'electronics')."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Max results (1-50)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Fetch full product details by product id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Product id (uuid)."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_suppliers",
        "title": "List suppliers",
        "description": "List PUBSTORE suppliers, optionally filtered by country or verified status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "country": {
              "type": "string",
              "description": "Country name filter."
            },
            "verifiedOnly": {
              "type": "boolean",
              "default": false,
              "description": "Only return verified suppliers."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_jobs",
        "title": "Search jobs",
        "description": "Search PUBSTORE job postings by keyword and optional location.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keyword to match against job title or description."
            },
            "location": {
              "type": "string",
              "description": "Optional location filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_properties",
        "title": "List properties",
        "description": "List PUBSTORE property listings filtered by kind, city, or bedrooms.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "rent",
                "sale",
                "short_stay"
              ],
              "description": "Listing kind."
            },
            "city": {
              "type": "string",
              "description": "City filter."
            },
            "minBedrooms": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "latest_news",
        "title": "Latest news",
        "description": "Fetch the latest PUBSTORE news articles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 10
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_rfq",
        "title": "Create RFQ",
        "description": "Post a Request For Quote on behalf of the signed-in buyer. Suppliers will be able to quote against it.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1,
              "description": "Product name or short description."
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "description": "Quantity required."
            },
            "unit": {
              "type": "string",
              "default": "pcs",
              "description": "Unit (pcs, kg, tons, etc)."
            },
            "targetPrice": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Target unit price in USD."
            },
            "destination": {
              "type": "string",
              "description": "Destination country/city."
            },
            "details": {
              "type": "string",
              "description": "Additional requirements or notes."
            }
          },
          "required": [
            "product",
            "quantity"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
